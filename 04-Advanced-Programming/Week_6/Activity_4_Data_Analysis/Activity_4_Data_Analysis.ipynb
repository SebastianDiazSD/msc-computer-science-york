   "source": [
    "# Activity 4 – Data Analysis\n",
    "**Course:** Advanced Programming – Week 6  \n",
    "**Author:** Sebastian Diaz  \n",
    "\n",
    "Uses the textbook datasets from McKinney (2017), Chapter 14:\n",
    "- **Section 14.3** – US Baby Names (1880–2010) from the US Social Security Administration\n",
    "- **Section 14.4** – USDA Food Database\n",
    "\n",
    "### Data setup\n",
    "These datasets are available with the textbook examples. Download from:\n",
    "- Baby names: https://www.ssa.gov/oact/babynames/limits.html (National data)\n",
    "- Or use the pre-processed files from the textbook GitHub: https://github.com/wesm/pydata-book\n",
    "- USDA data: included in the textbook's `ch14` folder as `database.json`\n",
    "\n",
    "Place files in the same directory as this notebook:\n",
    "- `yob1880.txt` ... `yob2010.txt` (or the combined `babynames` folder)\n",
    "- `database.json`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import json\n",
    "\n",
    "# Suppress matplotlib warnings\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Exercise 1 – US Baby Names (1880–2010)\n",
    "\n",
    "### Load and combine all annual files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Load all annual files from a 'names/' folder ---\n",
    "# Each file format: Name,Sex,Count (no header)\n",
    "# e.g. Mary,F,7065\n",
    "\n",
    "def load_baby_names(folder='names'):\n",
    "    frames = []\n",
    "    for year in range(1880, 2011):\n",
    "        path = os.path.join(folder, f'yob{year}.txt')\n",
    "        if not os.path.exists(path):\n",
    "            continue\n",
    "        df = pd.read_csv(path, names=['name', 'sex', 'births'])\n",
    "        df['year'] = year\n",
    "        frames.append(df)\n",
    "    if not frames:\n",
    "        raise FileNotFoundError(\n",
    "            \"No name files found. Download from https://www.ssa.gov/oact/babynames/limits.html\"\n",
    "            \" and extract into a 'names/' subfolder.\"\n",
    "        )\n",
    "    return pd.concat(frames, ignore_index=True)\n",
    "\n",
    "# Load\n",
    "names = load_baby_names('names')\n",
    "print(\"Shape:\", names.shape)\n",
    "print(names.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Task 1: Plot 5 random female and 5 random male names (1880–2010)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pivot so rows=year, columns=name, values=births — per sex\n",
    "def name_trend_table(names_df, sex):\n",
    "    \"\"\"Return a year × name pivot table for the given sex.\"\"\"\n",
    "    subset = names_df[names_df['sex'] == sex]\n",
    "    return subset.pivot_table(index='year', columns='name', values='births', aggfunc='sum').fillna(0)\n",
    "\n",
    "female_table = name_trend_table(names, 'F')\n",
    "male_table   = name_trend_table(names, 'M')\n",
    "\n",
    "# Random selection — reproducible with seed\n",
    "np.random.seed(42)\n",
    "female_sample = np.random.choice(female_table.columns, 5, replace=False)\n",
    "male_sample   = np.random.choice(male_table.columns,   5, replace=False)\n",
    "\n",
    "print(\"Randomly selected female names:\", female_sample.tolist())\n",
    "print(\"Randomly selected male names:  \", male_sample.tolist())\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "for name in female_sample:\n",
    "    axes[0].plot(female_table.index, female_table[name], label=name)\n",
    "axes[0].set_title('5 Random Female Names (1880–2010)')\n",
    "axes[0].set_xlabel('Year')\n",
    "axes[0].set_ylabel('Births')\n",
    "axes[0].legend(fontsize=8)\n",
    "axes[0].grid(True, linestyle='--', alpha=0.4)\n",
    "\n",
    "for name in male_sample:\n",
    "    axes[1].plot(male_table.index, male_table[name], label=name)\n",
    "axes[1].set_title('5 Random Male Names (1880–2010)')\n",
    "axes[1].set_xlabel('Year')\n",
    "axes[1].set_ylabel('Births')\n",
    "axes[1].legend(fontsize=8)\n",
    "axes[1].grid(True, linestyle='--', alpha=0.4)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('task1_random_names.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Task 2: Total male and female births 1880–2010"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "annual_births = names.groupby(['year', 'sex'])['births'].sum().unstack()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.plot(annual_births.index, annual_births['F'], label='Female', color='#e07070', linewidth=2)\n",
    "ax.plot(annual_births.index, annual_births['M'], label='Male',   color='#7090e0', linewidth=2)\n",
    "ax.fill_between(annual_births.index, annual_births['F'], alpha=0.15, color='#e07070')\n",
    "ax.fill_between(annual_births.index, annual_births['M'], alpha=0.15, color='#7090e0')\n",
    "ax.set_title('US Births by Sex (1880–2010)', fontsize=13)\n",
    "ax.set_xlabel('Year')\n",
    "ax.set_ylabel('Total Births')\n",
    "ax.legend()\n",
    "ax.grid(True, linestyle='--', alpha=0.4)\n",
    "plt.tight_layout()\n",
    "plt.savefig('task2_births_by_sex.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"Peak male births year:\",   annual_births['M'].idxmax())\n",
    "print(\"Peak female births year:\", annual_births['F'].idxmax())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Task 3: Top 3 male and female names per year — investigate popularity hypothesis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def top_n_per_year(names_df, sex, n=3):\n",
    "    \"\"\"Return a DataFrame of top-n names by births for each year.\"\"\"\n",
    "    subset = names_df[names_df['sex'] == sex]\n",
    "    return (\n",
    "        subset.groupby('year')\n",
    "              .apply(lambda g: g.nlargest(n, 'births')[['name', 'births']])\n",
    "              .reset_index(level=1, drop=True)\n",
    "    )\n",
    "\n",
    "top3_f = top_n_per_year(names, 'F', 3)\n",
    "top3_m = top_n_per_year(names, 'M', 3)\n",
    "\n",
    "# Inspect a specific year\n",
    "year = 1954\n",
    "print(f\"Top 3 female names in {year}:\")\n",
    "print(top3_f.loc[year])\n",
    "print(f\"\\nTop 3 male names in {year}:\")\n",
    "print(top3_m.loc[year])\n",
    "\n",
    "# How often does each name appear in the top 3?\n",
    "print(\"\\nMost frequent top-3 female names across all years:\")\n",
    "print(top3_f['name'].value_counts().head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Hypothesis Plan (~200 words)\n",
    "\n",
    "**Selected name:** *Linda* — one of the most dominant female names in the US during the late 1940s and 1950s. The data shows a sharp peak around 1947–1952 and a steep decline afterwards.\n",
    "\n",
    "**Hypothesis:** The popularity of *Linda* was strongly influenced by the release and widespread commercial success of the song *\"Linda\"* (1947) by Buddy Clark, combined with post-WWII social optimism that made softer, more melodic names fashionable.\n",
    "\n",
    "**How to test this:**\n",
    "\n",
    "1. **Music chart data** — source Billboard chart rankings 1944–1955 and correlate the song's chart position timeline with the rise in *Linda* births. The peak birth year (1947–1948) should lag the song's peak by ~9 months (conception lag).\n",
    "\n",
    "2. **Media coverage analysis** — scrape or access digitised newspaper archives (e.g., ProQuest Historical Newspapers) and count mentions of *Linda* as a name (not other uses) between 1944 and 1955 using named entity recognition.\n",
    "\n",
    "3. **Cross-name comparison** — identify other names linked to contemporaneous pop culture events (e.g., *Shirley* linked to Shirley Temple) and test whether all show similar lag-correlated patterns, to rule out coincidence.\n",
    "\n",
    "4. **Regression model** — fit a linear model with song chart position, media mentions, and birth year as predictors; test the coefficient and significance of each cultural factor."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Exercise 2 – USDA Food Database"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load USDA JSON database\n",
    "# Download from textbook GitHub: https://github.com/wesm/pydata-book/tree/2nd-edition/ch14\n",
    "with open('database.json', 'r') as f:\n",
    "    db = json.load(f)\n",
    "\n",
    "# Normalise into a flat DataFrame of nutrients\n",
    "# Each food item has: id, description, group, nutrients (list of dicts)\n",
    "info_keys = ['id', 'description', 'group']\n",
    "\n",
    "info = pd.DataFrame(db, columns=info_keys)\n",
    "\n",
    "# Flatten nutrients\n",
    "nutrients = []\n",
    "for food in db:\n",
    "    fnuts = pd.DataFrame(food['nutrients'])\n",
    "    fnuts['id'] = food['id']\n",
    "    nutrients.append(fnuts)\n",
    "\n",
    "nutrients = pd.concat(nutrients, ignore_index=True)\n",
    "nutrients.rename(columns={'description': 'nutrient'}, inplace=True)\n",
    "\n",
    "# Merge food info with nutrients\n",
    "ndata = pd.merge(nutrients, info, on='id')\n",
    "ndata.rename(columns={'description': 'food', 'group': 'food_group'}, inplace=True)\n",
    "\n",
    "print(\"Nutrients DataFrame shape:\", ndata.shape)\n",
    "print(ndata[['food', 'food_group', 'nutrient', 'value']].head(5))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Q1: Simple statistics for all nutrients in cheese-based products ---\n",
    "cheese = ndata[ndata['food_group'] == 'Dairy and Egg Products']\n",
    "cheese = cheese[cheese['food'].str.lower().str.contains('cheese')]\n",
    "\n",
    "cheese_stats = (\n",
    "    cheese.groupby('nutrient')['value']\n",
    "          .agg(['mean', 'median', 'std', 'min', 'max', 'count'])\n",
    "          .round(2)\n",
    "          .sort_values('mean', ascending=False)\n",
    ")\n",
    "\n",
    "print(f\"Nutrients in {cheese['food'].nunique()} cheese-based products:\")\n",
    "print(cheese_stats)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Q2: Frequency of each food group ('element') across the dataset ---\n",
    "group_counts = ndata.groupby('food_group')['food'].nunique().sort_values(ascending=True)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "group_counts.plot(kind='barh', ax=ax, color='steelblue', edgecolor='white')\n",
    "ax.set_title('Number of Food Items per Food Group', fontsize=12)\n",
    "ax.set_xlabel('Number of Foods')\n",
    "ax.set_ylabel('')\n",
    "ax.grid(axis='x', linestyle='--', alpha=0.4)\n",
    "plt.tight_layout()\n",
    "plt.savefig('q2_food_group_frequency.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Horizontal bar chosen because category labels are long text strings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Q3: Best sources of potassium ---\n",
    "# Definition of 'best': top potassium content per 100g serving (standard USDA measure)\n",
    "# Threshold: only foods where potassium value > 400mg/100g (well above average)\n",
    "# We exclude 'Spices and Herbs' as they are consumed in tiny quantities (not meaningful sources)\n",
    "\n",
    "potassium = ndata[ndata['nutrient'] == 'Potassium, K'].copy()\n",
    "potassium = potassium[potassium['food_group'] != 'Spices and Herbs']\n",
    "\n",
    "top_k = (\n",
    "    potassium.nlargest(20, 'value')[['food', 'food_group', 'value']]\n",
    "             .reset_index(drop=True)\n",
    ")\n",
    "top_k.columns = ['Food', 'Group', 'Potassium (mg/100g)']\n",
    "\n",
    "print(\"Top 20 sources of potassium (mg per 100g):\")\n",
    "print(top_k.to_string())\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "ax.barh(top_k['Food'], top_k['Potassium (mg/100g)'], color='#74c476', edgecolor='white')\n",
    "ax.axvline(400, color='red', linestyle='--', label='400mg threshold')\n",
    "ax.set_title('Top 20 Sources of Potassium (per 100g)', fontsize=12)\n",
    "ax.set_xlabel('Potassium (mg/100g)')\n",
    "ax.invert_yaxis()\n",
    "ax.legend()\n",
    "ax.grid(axis='x', linestyle='--', alpha=0.4)\n",
    "plt.tight_layout()\n",
    "plt.savefig('q3_potassium_sources.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
